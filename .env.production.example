# Production configuration.
#
#   cp .env.production.example .env.production
#   # fill in every value marked CHANGE ME
#   docker compose -f docker-compose.yml -f docker-compose.production.yml \
#       --env-file .env.production up -d
#
# docs/DEPLOY.md is the procedure. This file is every knob it turns. Nothing here
# has a working default: a placeholder that boots is a placeholder that reaches
# production.

# ── Identity ──────────────────────────────────────────────────────────────────

# The hostname. Caddy provisions a certificate for it and redirects www to it.
SITE_HOST=trovato.rs

# Every absolute URL the site emits: canonicals, Open Graph, sitemap entries,
# feed self-links. The scheme matters; it is https in production.
#
# Declared twice, unavoidably. The kernel reads SITE_URL from the environment and
# a plugin cannot read the environment, so config/variable.site_base_url.yml
# carries the same value for the plugin that builds the sitemap. `cargo test -p
# checks` fails if the two defaults drift apart. Change both or neither.
SITE_URL=https://trovato.rs

# Where the certificate authority writes about expiry and problems. A real
# mailbox somebody reads.
ACME_EMAIL=CHANGE ME

# ── The kernel ────────────────────────────────────────────────────────────────

# The release this deployment runs. Never `latest`: an upgrade should be a commit
# somebody made on purpose, not whatever was published overnight.
TROVATO_VERSION=0.101.0

RUST_LOG=info,tower_http=info,sqlx=warn

# ── Database ──────────────────────────────────────────────────────────────────

POSTGRES_USER=trovato
POSTGRES_DB=trovato
# CHANGE ME. Generate one: openssl rand -base64 36
POSTGRES_PASSWORD=CHANGE ME

# ── The clock ─────────────────────────────────────────────────────────────────

# The kernel runs no internal scheduler. Scheduled publishing, search index
# rebuilds and the comment moderation queue all fire from a POST to
# /cron/${CRON_KEY}, which the cron container sends on this interval. A weak key
# is a way for anybody to make the site do work.
#
# CHANGE ME. Generate one: openssl rand -hex 32
CRON_KEY=CHANGE ME
CRON_INTERVAL=60

# ── The network ───────────────────────────────────────────────────────────────

# The proxy's fixed address, and the subnet it comes from. TRUSTED_PROXIES names
# this exactly: without it every visitor shares one bucket of a hundred requests
# a minute, and with the wrong value nobody's forwarded address is believed.
COMPOSE_SUBNET=172.31.71.0/24
PROXY_IP=172.31.71.10

# ── Mail ──────────────────────────────────────────────────────────────────────
#
# Without these, registration creates an account and cannot send its verification
# link, so nobody can finish signing up: the database stores only the token's
# hash and the plaintext existed only in the email. The contact form silently
# sends nothing for the same reason. Both are working features waiting on this
# block.
#
# CHANGE ME, all four.
SMTP_HOST=CHANGE ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE ME
SMTP_PASSWORD=CHANGE ME
# starttls on 587, tls on 465, none only on a host you control end to end.
SMTP_ENCRYPTION=starttls
# The address system mail comes from. It has to be one the SMTP host will let you
# send as.
SITE_MAIL=hello@trovato.rs

# ── AI ────────────────────────────────────────────────────────────────────────
#
# Optional, and the site is honest about being without it. Two things do not run
# until it is set: comment classification, so every comment from an account that
# has not earned its way past the queue waits for a person; and the two
# AI stages of search, so search is keyword-only. Both failure modes are the safe
# ones and both are stated on the site.
#
# Which provider, and where its key lives. The kernel does not hold the key: the
# `ai_providers` entry in site configuration names an environment variable, and
# the kernel reads that variable. So there are two things to set, in two places:
#
#   1. Here: the variable's name and its value.
#   2. In config/: a `variable.ai_providers.yml` naming the same variable, the
#      provider's protocol, and the model. Then re-import.
#
# Leave both empty until the provider, the model and the monthly budget are
# decided. Nothing breaks; two features stay off and the site says they are off.
AI_API_KEY_ENV=ANTHROPIC_API_KEY
AI_API_KEY=

# ── Comments ──────────────────────────────────────────────────────────────────
# These live in config/ and are listed here so the operator knows they exist:
#   comment_default_status   pending
#   comment_trust_threshold  3
# Change them in config/ and re-import, not here.
