# Local overrides for docker-compose.yml. Copy to .env and edit; every value
# below is the default the compose file already uses, so an empty .env changes
# nothing. Production settings live in .env.production.example (Phase 8).

# The pinned kernel release. Never `latest`: a rebuild that floats to a new
# release is not a rebuild of the same site.
TROVATO_VERSION=0.101.0

# Where the local site listens. Bound to 127.0.0.1 by the compose file.
SITE_PORT=3080

# The single source of every absolute URL the site emits.
SITE_URL=https://trovato.rs

# The kernel runs no internal scheduler; the cron container POSTs to
# /cron/${CRON_KEY} on this interval, in seconds.
CRON_KEY=local-development-cron-key
CRON_INTERVAL=60

# The local administrator, created by scripts/run.sh through the installer.
# Local only. Production credentials come from the environment, never a file.
ADMIN_USER=admin
ADMIN_MAIL=admin@trovato.rs
ADMIN_PASS=trovato-local-admin
