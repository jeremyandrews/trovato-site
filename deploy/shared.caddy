# The site itself, shared by the local and production entry points.
#
# Imported as a snippet rather than duplicated: what differs between a local
# run and production is the address, the certificate and the www redirect, and
# nothing about how the site is served. Two copies of this would drift.
(site) {
	encode zstd gzip

	# ── The site's own static files ────────────────────────────────────────
	handle /static/* {
		root * /srv/public
		@present file
		route {
			header @present ?Cache-Control "public, max-age=3600"
			# Fonts and brand marks change when the brand does, which is not
			# often. Not `immutable`: these filenames carry no content hash, so a
			# reader who cached one has no way to be told it changed.
			@long path /static/fonts/* /static/brand/*
			header @long ?Cache-Control "public, max-age=604800"
			file_server @present
			# Not the site's: the kernel image ships its own css and js under the
			# same prefix, and they are still served from there.
			reverse_proxy site:3000
		}
	}

	# ── The sitemap ────────────────────────────────────────────────────────
	# The kernel owns /sitemap.xml and emits paths where the protocol requires
	# absolute URLs, and it lists items only. The site serves a correct one, and
	# a plugin cannot claim the standard path because axum panics on a duplicate
	# route. So the standard path is mapped here.
	handle /sitemap.xml {
		rewrite * /sitemap/pages.xml
		header ?Cache-Control "public, max-age=3600"
		reverse_proxy site:3000
	}

	# ── Documents ──────────────────────────────────────────────────────────
	# Feeds, robots.txt, llms.txt and the raw markdown behind each documentation
	# page. All public, none of them personal, and none worth a round trip every
	# time a reader's aggregator wakes up.
	@documents path /rss/* /robots.txt /llms.txt /learn/raw/* /sitemap/*
	handle @documents {
		header ?Cache-Control "public, max-age=3600"
		reverse_proxy site:3000
	}

	# ── Everything else ────────────────────────────────────────────────────
	handle {
		route {
			# A page rendered for somebody with a session is that person's page.
			# `Vary: Cookie` says so to every cache in between, and `private`
			# keeps it out of the shared ones.
			@session header Cookie *id=*
			header @session Cache-Control "private, no-store"
			header @session Vary "Cookie, Accept-Encoding"

			@anonymous not header Cookie *id=*
			# A minute of freshness with ten minutes of serving stale while it
			# revalidates. Short, because publishing a comment or a post should
			# show up in about a minute, not tomorrow.
			header @anonymous Cache-Control "public, max-age=60, stale-while-revalidate=600"
			header @anonymous Vary "Cookie, Accept-Encoding"

			reverse_proxy site:3000
		}
	}

	# The kernel already sends X-Frame-Options, X-Content-Type-Options,
	# Referrer-Policy, Permissions-Policy and a CSP, so none of them is repeated
	# here. HSTS is not here either: it is a statement about the transport, it is
	# only true once there is a real certificate, and it is set by the production
	# entry point for that reason.
}
